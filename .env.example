# Arquivo de exemplo de variáveis de ambiente para UaiRoute
# Copie este arquivo para .env e ajuste as configurações conforme necessário
#
# Com Docker Compose, as variáveis do backend já vêm definidas no
# docker-compose.yml / docker-compose.prod.yml. Este arquivo serve para
# execução local sem Docker e para sobrescrever valores em produção.

# === CONFIGURAÇÕES DO BACKEND (Django) ===
DEBUG=True

# Obrigatória em produção (DEBUG=False). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Senha do administrador padrão (admin@teste.com).
# Obrigatória em produção (DEBUG=False). Em desenvolvimento, usa "admin" como fallback.
# Recomenda-se usar uma senha forte e aleatória em produção.
ADMIN_PASSWORD=

# Lista separada por vírgulas. 'backend' é o hostname do container usado
# pelo frontend dentro da rede do Compose.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origens confiáveis para CSRF, separadas por vírgula.
CSRF_TRUSTED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Caminho do arquivo SQLite. Sem esta variável o Django usa
# backend/db.sqlite3 (padrão para desenvolvimento local sem Docker).
# No Compose ela aponta para o volume persistente: /app/data/db.sqlite3
# DATABASE_PATH=/app/data/db.sqlite3

# === CONFIGURAÇÕES DO FRONTEND (Flask) ===
SERVER_IP=localhost
BACKEND_URL=http://localhost:8000

# Chave da OpenRouteService, usada no cálculo de rotas das ordens de serviço.
# Obtenha em https://openrouteservice.org/dev/#/signup
# Lida tanto pelo backend (Django, ao criar/editar uma ordem de serviço)
# quanto pelo frontend (Flask, na tela de visualização de ordem). Sem ela,
# o backend simplesmente não calcula distancia_total/tempo_estimado, e o
# frontend responde 503 no cálculo de rota.
ORS_API_KEY=

# === DOCKER ESPECÍFICO ===
# Descomente as linhas abaixo quando executar com Docker
# SERVER_IP=backend
# BACKEND_URL=http://backend:8000
