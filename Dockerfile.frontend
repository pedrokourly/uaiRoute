# Dockerfile para o Frontend Flask
FROM python:3.12-slim

# Definir diretório de trabalho
WORKDIR /app

# Sem isso o stdout do Python fica em block-buffering e os logs do Flask
# não aparecem em tempo real em `docker logs`.
ENV PYTHONUNBUFFERED=1

# Instalar curl para verificação de saúde
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements
COPY requirements.txt .

# Instalar dependências Python
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código do frontend
COPY frontend/ .

# Expor porta
EXPOSE 5000

# A espera pelo backend é feita pelo depends_on/healthcheck do docker-compose.
CMD ["python", "uairoute.py"]
