# Dockerfile para o Backend Django
FROM python:3.12-slim

# Definir diretório de trabalho
WORKDIR /app

# Sem isso o stdout do Python fica em block-buffering e mensagens como a
# criação do admin padrão (ou erros no bootstrap) não aparecem em `docker logs`.
ENV PYTHONUNBUFFERED=1

# Instalar dependências do sistema
# curl é usado pelo healthcheck do docker-compose.prod.yml
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements
COPY requirements.txt .

# Instalar dependências Python
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código do backend
COPY backend/ .

# Ponto de montagem do volume backend_data. demos/ recebe um arquivo SQLite
# por visitante do demo; a semente fica na raiz de data/.
RUN mkdir -p /app/data/demos

# Expor porta
EXPOSE 8000

# Aplica as migrações antes de subir — é o que faz um clone limpo funcionar.
# O manage.py cria o administrador padrão ao detectar o comando runserver.
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8000"]
